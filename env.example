# Inteligencia artificial (Gemini). Llave gratuita en https://aistudio.google.com/apikey
# Copia este archivo como ".env" y escribe tu llave (en la misma carpeta que analizador.py) y rellena los valores. 
# El archivo .env NUNCA se sube a git.

# ---------------- Que IA se usa ----------------
# Proveedor principal (se intenta primero): gemini | claude
IA_PROVEEDOR_PRINCIPAL=claude
# Proveedor de respaldo si el principal falla: gemini | claude | ninguno
# (vacio = el otro proveedor). Se omite solo si no tiene API key.
IA_PROVEEDOR_SECUNDARIO=gemini
# Espera maxima por intento, en segundos (cada modelo de la lista cuenta como un intento)
IA_TIMEOUT_SEGUNDOS=60
# true = al guardar los puntos se lanza solo el analisis con IA y la clasificacion KNN
IA_ANALISIS_AUTOMATICO=true

# ---------------- Gemini ----------------
# Modelo principal. Si falla, lista los disponibles con: python analizador.py --listar-modelos
# Modelos en orden de prioridad: si el primero falla, se prueba el siguiente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelos alternos separados por coma (se prueban en orden si el principal falla). Puede quedar vacio.
GEMINI_MODELOS_RESPALDO=gemini-3.6-flash,gemini-3.5-flash-lite

# ---------------- Claude ----------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Modelos alternos de Claude separados por coma, por ejemplo: claude-haiku-5-5
CLAUDE_MODELOS_RESPALDO=

# true = al guardar los puntos se lanza solo el analisis con IA y la clasificacion KNN
# false = solo se guardan los puntos
IA_ANALISIS_AUTOMATICO=true

# Las imágenes (con y sin puntos), el .txt de coordenadas y la respuesta de la IA se guardan en
#     resultados/archivos_ia/<nombre_de_la_foto>/
# True  = se CONSERVAN ahi (para revisarlos).
# False = se borran al terminar el análisis.
CONSERVAR_ARCHIVOS_TEMPORALES = True

CLAUDE_EJECUTAR_CODIGO=true
CLAUDE_CODIGO_TIMEOUT_SEGUNDOS=180
CLAUDE_TOOL_CODIGO=code_execution_20250825